# Use deterministic fixtures without calling an AI provider.
GENERATIVE_UI_USE_MOCKS=false

# When GENERATIVE_UI_USE_MOCKS=false, the app uses the local Claude Code CLI
# session by default (run `claude auth login` once — no API key needed here).
ANTHROPIC_MODEL=sonnet

# Optional — set both to use Azure OpenAI instead of the local Claude Code CLI.
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_MODEL=gpt-4o-mini